{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "ittvtwodemo",
	"version": "0.1.0",
	"identifier": "com.ortiza4.ittvtwodemo",
	"build": {
		"frontendDist": "../dist",
		"devUrl": "http://localhost:8081",
		"beforeDevCommand": "expo start --web",
		"beforeBuildCommand": "npx expo export --platform web"
	},
	"app": {
		"windows": [
			{
				"title": "ittvtwodemo",
				"width": 2160,
				"height": 3840,
				"fullscreen": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"android": {
			"debugApplicationIdSuffix": ".debug"
		}
	}
}
